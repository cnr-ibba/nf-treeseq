nextflow_pipeline {

    name "Test pipeline with https://palamaralab.github.io/software/threads/"
    script "../main.nf"
    tag "pipeline"
    tag "threads"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                ancestor_method = 'threads'
                threads_demography_file = "${projectDir}/tests/test_dataset.demo"
                plink_species = "--chr-set 26 no-xy no-mt --allow-no-sex"
                threads_query_interval = 0.005
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content (excluding non-deterministic files via .nftignore)
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.succeeded().size() > 0 },
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // All stable path names with relative paths
                    stable_name
                ).match() }
            )
        }
    }
}
